####################################
# 🦎 KOMODO COMPOSE - VARIABLES 🦎 #
####################################
#
# Modèle basé sur compose/compose.env officiel (github.com/moghtech/komodo, branche main).
# NE PAS remplir ce fichier à la main : lancer ./dev-deploy.sh core
# qui génère core/compose.env (jamais commité) avec des secrets aléatoires.
#
# Écarts volontaires par rapport au fichier officiel :
#   - TZ=Europe/Paris ;
#   - création de comptes verrouillée (registration / new users / non-admin create) ;
#   - OAuth GitHub/Google désactivés, bloc OIDC présent mais commenté.

## Tag d'image Komodo, suit le semver "major.minor.patch".
COMPOSE_KOMODO_IMAGE_TAG="2"
## Sauvegardes datées de la base sur l'hôte - https://komo.do/docs/setup/backup
COMPOSE_KOMODO_BACKUPS_PATH=/etc/komodo/backups

## Identifiants de la base de données
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=CHANGE_ME

## Fuseau horaire (utilisé par les planifications)
TZ=Europe/Paris

#=-------------------------=#
#= Komodo Core Environment =#
#=-------------------------=#

## Liste complète des variables + descriptions :
## 🦎 https://github.com/moghtech/komodo/blob/main/config/core.config.toml 🦎

## Les variables secrètes acceptent aussi la syntaxe `${VARIABLE}_FILE`
## pour les secrets docker compose.

## URL publique de Komodo (suggestion d'URL pour OAuth / webhooks).
KOMODO_HOST=https://CHANGE_ME.example.com
## Titre affiché dans l'onglet du navigateur.
KOMODO_TITLE=Komodo

## Autorise la connexion des Periphery via leur clé publique générée.
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub

## Connexion par identifiant + mot de passe.
KOMODO_LOCAL_AUTH=true
## Compte admin initial créé au premier démarrage.
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=CHANGE_ME

## Nom du premier Server créé automatiquement (le Periphery local).
## Convention : le hostname de la machine.
KOMODO_FIRST_SERVER_NAME=CHANGE_ME

## Boutons d'exécution en double-clic plutôt que dialogue de confirmation.
KOMODO_DISABLE_CONFIRM_DIALOG=false

## Désactive la création des Procedures par défaut au premier démarrage.
KOMODO_DISABLE_INIT_RESOURCES=false

## Limite de pagination par défaut (API et UI).
KOMODO_DEFAULT_PAGINATION_LIMIT=50

## Authentifie les webhooks entrants. Alt : KOMODO_WEBHOOK_SECRET_FILE
KOMODO_WEBHOOK_SECRET=CHANGE_ME
## Sert à générer les JWT. Alt : KOMODO_JWT_SECRET_FILE
KOMODO_JWT_SECRET=CHANGE_ME
## Durée de vie des JWT. Options : 1-hr, 12-hr, 1-day, 3-day, 1-wk, 2-wk
KOMODO_JWT_TTL="1-day"

## Fréquence de la supervision des serveurs (statut / conteneurs / stats / alertes).
## Options : 1-sec, 5-sec, 15-sec, 1-min, 5-min, 15-min — défaut : 15-sec
KOMODO_MONITORING_INTERVAL="15-sec"
## Fréquence du poll des Resources (mises à jour / actions automatiques).
## Options : 5-min, 15-min, 1-hr, 2-hr, 6-hr, 12-hr, 1-day — défaut : 1-hr
KOMODO_RESOURCE_POLL_INTERVAL="1-hr"

## --- Verrouillage de la création de comptes (écart volontaire) ---
## Interdit les inscriptions de nouveaux utilisateurs.
KOMODO_DISABLE_USER_REGISTRATION=true
## Les nouveaux comptes ne sont PAS activés automatiquement.
KOMODO_ENABLE_NEW_USERS=false
## Les non-admins ne peuvent pas créer de ressources.
KOMODO_DISABLE_NON_ADMIN_CREATE=true
## Pas d'accès Read global pour tous les utilisateurs.
KOMODO_TRANSPARENT_MODE=false

## --- OIDC (désactivé, bloc conservé pour un futur SSO self-hosted) ---
KOMODO_OIDC_ENABLED=false
## Doit être joignable depuis le conteneur Komodo Core.
# KOMODO_OIDC_PROVIDER=https://oidc.provider.internal/application/o/komodo
## Hôte joignable par les utilisateurs (optionnel si identique au précédent).
## Ne PAS inclure la partie `path` de l'URL.
# KOMODO_OIDC_REDIRECT_HOST=https://oidc.provider.external
# KOMODO_OIDC_CLIENT_ID=        # Alt : KOMODO_OIDC_CLIENT_ID_FILE
# KOMODO_OIDC_CLIENT_SECRET=    # Alt : KOMODO_OIDC_CLIENT_SECRET_FILE (inutile si PKCE)
# KOMODO_OIDC_USE_FULL_EMAIL=true
# KOMODO_OIDC_ADDITIONAL_AUDIENCES=abc,123  # Alt : _FILE

## --- OAuth GitHub / Google (désactivés — écart volontaire) ---
KOMODO_GITHUB_OAUTH_ENABLED=false
KOMODO_GOOGLE_OAUTH_ENABLED=false

## Logs plus lisibles (lignes vides entre les logs)
KOMODO_LOGGING_PRETTY=false
## Affichage multi-lignes de la config au démarrage
KOMODO_PRETTY_STARTUP_CONFIG=false

#=------------------------------=#
#= Komodo Periphery Environment =#
#=------------------------------=#

## Liste complète des variables + descriptions :
## 🦎 https://github.com/moghtech/komodo/blob/main/config/periphery.config.toml 🦎

## Adresse du Core pour le Periphery LOCAL (réseau interne du compose).
PERIPHERY_CORE_ADDRESS=ws://core:9120
## Se connecte sous le même nom que KOMODO_FIRST_SERVER_NAME.
PERIPHERY_CONNECT_AS=CHANGE_ME
## Clé publique du Core, générée par le Core (volume partagé "keys").
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub

## Répertoire racine du Periphery. Tous les composes / repos gérés
## doivent être DANS ce répertoire (identique hôte / conteneur) :
## - /etc/komodo
## --- ./stacks
## --- ./repos
## --- ./builds
PERIPHERY_ROOT_DIRECTORY=/etc/komodo

## Terminaux distants (shell dans le conteneur Periphery).
PERIPHERY_DISABLE_TERMINALS=false
## Exec / attach distant dans les conteneurs gérés.
PERIPHERY_DISABLE_CONTAINER_TERMINALS=false

## Si la taille disque remonte mal, filtrer les points de montage.
## Liste séparée par des virgules. /etc/hostname seul donne souvent la bonne taille.
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
# PERIPHERY_EXCLUDE_DISK_MOUNTS=/snap,/etc/repos

## Logs plus lisibles
PERIPHERY_LOGGING_PRETTY=false
PERIPHERY_PRETTY_STARTUP_CONFIG=false
