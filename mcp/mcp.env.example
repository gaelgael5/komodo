##########################################
# 🦎 KOMODO MCP SERVER - VARIABLES 🦎 #
##########################################
#
# NE PAS remplir ce fichier à la main : lancer ./dev-deploy.sh mcp
# qui génère mcp/mcp.env (jamais commité).
#
# Référence complète :
# https://github.com/MP-Tool/komodo-mcp-server/blob/main/config/README.md

## Tag d'image (majeur épinglé, pas de latest)
KOMODO_MCP_IMAGE_TAG=1
## Port d'écoute publié sur l'hôte
KOMODO_MCP_PORT=8000

## Fuseau horaire
TZ=Europe/Paris

## Transport : serveur HTTP persistant (streamable HTTP)
MCP_TRANSPORT=http

## URL du Core Komodo, vue DEPUIS le conteneur MCP.
## Ex. : http://192.168.1.10:9120 ou https://komodo.example.com
KOMODO_URL=CHANGE_ME

## ------------------------------------------------------------------
## Authentification des clients MCP (activée par défaut) :
## chaque agent se connecte avec un compte Komodo (login navigateur)
## et hérite des permissions de CE compte — c'est le garde-fou principal.
## Ne désactiver sous aucun prétexte sur un transport réseau.
# MCP_AUTH_ENABLED=true

## Connexion Komodo globale (clé d'API) : utilisée UNIQUEMENT en mode
## stdio ou si l'auth est désactivée. Inutile dans la configuration
## recommandée ci-dessus — laisser vide.
# KOMODO_API_KEY=
# KOMODO_API_SECRET=

## ------------------------------------------------------------------
## Garde-fous (écarts volontaires par rapport aux défauts amont)

## Confirmation humaine avant toute action destructive (défaut amont : true).
MCP_CONFIRM_DESTRUCTIVE=true
## Si le client ne sait pas afficher la confirmation : refuser l'appel.
MCP_CONFIRM_FALLBACK=deny

## Surface d'outils limitée aux niveaux komodo:read + komodo:operate :
## on retire les catégories sans intérêt pour les agents...
MCP_TOOLS_EXCLUDED_CATEGORIES=user,terminal
## ...et tous les outils de niveau komodo:admin (create/update/delete/prune),
## liste extraite du code v1.5.0 (requiredScopes = komodo:admin).
MCP_TOOLS_EXCLUDED_TOOLS=komodo_action_apply,komodo_action_delete,komodo_alerter_apply,komodo_alerter_delete,komodo_build_apply,komodo_build_delete,komodo_builder_apply,komodo_builder_copy,komodo_builder_delete,komodo_builder_rename,komodo_deployment_apply,komodo_deployment_delete,komodo_procedure_apply,komodo_procedure_delete,komodo_repo_apply,komodo_repo_delete,komodo_resource_sync_apply,komodo_resource_sync_delete,komodo_server_action,komodo_server_apply,komodo_server_delete,komodo_stack_apply,komodo_stack_delete,komodo_swarm_apply,komodo_swarm_delete,komodo_tag_apply,komodo_tag_delete,komodo_variable_apply,komodo_variable_delete

## ------------------------------------------------------------------
## Derrière un reverse proxy / nom DNS dédié (optionnel) :
# MCP_BASE_URL=https://mcp.example.com
# MCP_TRUST_PROXY=true
## Protection DNS-rebinding : si le serveur rejette vos requêtes à cause
## de l'en-tête Host, lister ici les hôtes légitimes :
# MCP_ALLOWED_HOSTS=192.168.1.10:8000,mcp.example.com
