########################################
# 🦎 KOMODO PERIPHERY - VARIABLES 🦎 #
########################################
#
# NE PAS remplir ce fichier à la main : lancer ./dev-deploy.sh periphery
# qui génère periphery/periphery.env (jamais commité).

## Tag d'image Komodo (aligné sur le Core).
COMPOSE_KOMODO_IMAGE_TAG=2

## Fuseau horaire
TZ=Europe/Paris

## Adresse du Core à joindre (connexion websocket SORTANTE depuis cet hôte).
## En direct : ws://<ip-du-core>:9120
## Derrière un reverse proxy TLS : wss://komodo.example.com
PERIPHERY_CORE_ADDRESS=ws://CHANGE_ME:9120

## Nom du Server Komodo sous lequel se connecter.
## Convention : le hostname de la machine. Doit correspondre à l'entrée
## de syncs/servers.toml si l'hôte y est déclaré.
PERIPHERY_CONNECT_AS=CHANGE_ME

## Clé d'enrôlement ("Server Onboarding Key", format O-...),
## créée dans l'UI du Core : Settings -> Onboarding Keys.
## Elle permet au Periphery de créer son Server dans Komodo au premier contact.
## Elle devient INUTILE après la première connexion : la retirer ensuite.
PERIPHERY_ONBOARDING_KEY=

## Clés publiques de Core acceptées.
## file:... : le fichier est écrit automatiquement à la PREMIÈRE connexion
## pour épingler le Core contacté (trust-on-first-use), puis vérifié ensuite.
## Durcissement possible : coller ici directement la clé publique du Core
## (affichée par scripts/bootstrap-core.sh) au lieu du chemin de fichier.
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub

## Répertoire racine du Periphery. Tous les composes / repos gérés
## doivent être DANS ce répertoire (identique hôte / conteneur).
PERIPHERY_ROOT_DIRECTORY=/etc/komodo

## Terminaux distants (shell dans le conteneur Periphery).
PERIPHERY_DISABLE_TERMINALS=false
## Exec / attach distant dans les conteneurs gérés.
PERIPHERY_DISABLE_CONTAINER_TERMINALS=false

## Si la taille disque remonte mal, filtrer les points de montage.
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
# PERIPHERY_EXCLUDE_DISK_MOUNTS=/snap,/etc/repos

## Logs plus lisibles
PERIPHERY_LOGGING_PRETTY=false
PERIPHERY_PRETTY_STARTUP_CONFIG=false
